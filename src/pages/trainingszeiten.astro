---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const order = ["Montag","Dienstag","Mittwoch","Donnerstag","Freitag","Samstag","Sonntag"];
const trainings = (await getCollection("trainings")).sort((a,b)=> order.indexOf(a.data.weekday) - order.indexOf(b.data.weekday));
---
<Base title="Training – Basket Tigers Vienna">
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Wir trainieren</span>
        <h1 class="h1" style="margin-top:10px;">Trainingszeiten</h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {trainings.length === 0 ? (
        <div class="card pad"><p class="p">Noch keine Trainingszeiten eingetragen.</p></div>
      ) : (
        <div class="card pad">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Tag</th><th>Zeit</th><th>Ort</th><th>Notiz</th></tr>
              </thead>
              <tbody>
                {trainings.map(t => (
                  <tr>
                    <td style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px;">{t.data.weekday}</td>
                    <td style="white-space:nowrap;">{t.data.time}</td>
                    <td>{t.data.location}</td>
                    <td class="p">{t.data.note ?? ""}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
