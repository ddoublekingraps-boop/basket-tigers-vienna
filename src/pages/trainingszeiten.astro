---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

// Reihenfolge der Teams; unbekannte Teams danach alphabetisch
const teamOrder = ["Herren 1", "Herren 2", "Herren 3", "U19"];
const rank = (team: string) => { const i = teamOrder.indexOf(team); return i < 0 ? 99 : i; };

const trainings = (await getCollection("trainings")).sort((a, b) =>
  rank(a.data.team) - rank(b.data.team) ||
  a.data.team.localeCompare(b.data.team, "de") ||
  a.data.firstDay - b.data.firstDay
);

// "Montag & Freitag" bzw. "Montag, Mittwoch & Freitag"
const joinDays = (days: string[]) =>
  days.length <= 1 ? (days[0] ?? "") : days.slice(0, -1).join(", ") + " & " + days[days.length - 1];

const hasNotes = trainings.some(t => t.data.note);
---
<Base>
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Wir trainieren</span>
        <h1 class="h1" style="margin-top:10px;">Trainingszeiten</h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {trainings.length === 0 ? (
        <div class="card pad"><p class="p">Noch keine Trainingszeiten eingetragen.</p></div>
      ) : (
        <div class="card pad">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Team</th><th>Tage</th><th>Zeit</th><th>Ort</th>{hasNotes && <th>Notiz</th>}</tr>
              </thead>
              <tbody>
                {trainings.map(t => (
                  <tr>
                    <td class="text-orange" style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px; white-space:nowrap;">{t.data.team}</td>
                    <td style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px;">{joinDays(t.data.days)}</td>
                    <td style="white-space:nowrap; font-weight:600;">{t.data.time}{t.data.time && !/uhr/i.test(t.data.time) ? " Uhr" : ""}</td>
                    <td>{t.data.location}</td>
                    {hasNotes && <td class="p">{t.data.note}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
