---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const sponsoren = await getCollection("sponsoren");

/**
 * Gibt eine optimierte Logo-URL zurück.
 * Netlify Image CDN liefert in Produktion WebP in der richtigen Größe aus.
 * Sponsor-Logos werden maximal 600 × 200 px angezeigt (volle Kartenbreite).
 */
function sponsorLogoUrl(logo: string): string {
  if (import.meta.env.PROD) {
    return `/.netlify/images?url=${encodeURIComponent(logo)}&w=600&h=200&fit=contain&fm=webp&q=85`;
  }
  return logo;
}
---
<Base>
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Partner</span>
        <h1 class="h1" style="margin-top:10px;">Sponsoren</h1>
      </div>
      <a class="btn2 btn-sm" href="/kontakt/">Partner werden →</a>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {sponsoren.length === 0 ? (
        <div class="card pad"><p class="p">Bald stellen wir hier unsere Partner vor.</p></div>
      ) : (
        <div class="grid3">
          {sponsoren.map(s => (
            <article class="card card-hover sponsor-card">
              <img
                class="sponsor-logo"
                src={sponsorLogoUrl(s.data.logo)}
                alt={s.data.name}
                width="600"
                height="200"
                loading="lazy"
                decoding="async"
              />
              <div style="display:flex; justify-content:space-between; width:100%; align-items:center; gap:10px;">
                <span style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px;">{s.data.name}</span>
              </div>
              {s.body ? <div class="p" style="white-space:pre-wrap;">{s.body}</div> : null}
              {s.data.url ? <a class="btn2 btn-sm" href={s.data.url} target="_blank" rel="noopener noreferrer">Website →</a> : null}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
