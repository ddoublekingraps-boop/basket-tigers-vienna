---
import Base from "../layouts/Base.astro";
import Socials from "../components/Socials.astro";
import { getCollection } from "astro:content";
import { getImageSize, sponsorLogoSize, sponsorLogoUrl } from "../lib/images";
import { fmtDay, fmtTime } from "../lib/games";

// Echte Pixelmasse des Hero-Logos -> width/height-Attribute ohne erfundenes Ratio
const heroLogo = "/assets/logo.png";
const heroLogoSize = getImageSize(heroLogo);

const allGames = await getCollection("games");
const teams = await getCollection("teams");
const allNews = (await getCollection("news")).sort((a,b)=> b.data.date.getTime()-a.data.date.getTime());
const sponsoren = await getCollection("sponsoren");

// ----- Spiele fuer die Startseite -----
// Gerendert werden alle kommenden Spiele; welche davon sichtbar sind (nur die naechsten
// 7 Tage) entscheidet ein kleines Script im Browser. So stimmt die Auswahl auch dann,
// wenn die Seite schon ein paar Tage nicht neu gebaut wurde.
const RUNNING_MS = 1000*60*60*3; // ein Spiel gilt ab Tip-Off noch 3h als "aktuell"
const buildNow = Date.now();
const datedUpcoming = allGames
  .filter(g => g.data.date && g.data.date.getTime() >= buildNow - RUNNING_MS)
  .sort((a,b) => a.data.date!.getTime() - b.data.date!.getTime());
const tbdGames = allGames.filter(g => !g.data.date);
// Termine ohne Datum nur als Notloesung, wenn kein Spiel mit Datum ansteht
const homeGames = (datedUpcoming.length ? datedUpcoming : tbdGames.slice(0,1)).slice(0, 40);

const latestNews = allNews.slice(0, 3);


const tabs = [
  { href:"/teams/", label:"Teams", desc:"Unsere Mannschaften", icon:`<path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.7 0-8 1.34-8 4v3h9v-3c0-1 .4-2.1 1.2-3-.7-.6-1.6-1-2.2-1Zm8 0c-3.3 0-10 1.66-10 5v3h20v-3c0-3.34-6.7-5-10-5Z"/>` },
  { href:"/spielzeiten/", label:"Spiele", desc:"Termine & Gegner", icon:`<path d="M7 2v2H5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3h-2V2h-2v2H9V2H7Zm13 8v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9h16Z"/>` },
  { href:"/trainingszeiten/", label:"Training", desc:"Zeiten & Orte", icon:`<path d="M12 1a11 11 0 1 0 11 11A11 11 0 0 0 12 1Zm0 2a9 9 0 0 1 6.3 2.6A14.9 14.9 0 0 0 13 7.2V3.05c-.33-.03-.66-.05-1-.05Zm-2 .3v5A14.8 14.8 0 0 0 5 12H3.05A9 9 0 0 1 10 3.3ZM12 11a1 1 0 1 1-1 1 1 1 0 0 1 1-1Zm9 2a9 9 0 0 1-7 8.7v-5a14.8 14.8 0 0 0 5-2.8H21Zm-11 8.7A9 9 0 0 1 3.7 16h4.04A14.9 14.9 0 0 0 10 16.8v4.9Z"/>` },
  { href:"/news/", label:"News", desc:"Neues vom Rudel", icon:`<path d="M4 3a2 2 0 0 0-2 2v13a3 3 0 0 0 3 3h13a3 3 0 0 0 3-3V3H4Zm2 4h9v2H6V7Zm0 4h9v2H6v-2Zm0 4h6v2H6v-2Z"/>` },
  { href:"/spieler/", label:"Spieler", desc:"Der Kader", icon:`<path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4 0-9 2-9 6v2h18v-2c0-4-5-6-9-6Z"/>` },
  { href:"/sponsoren/", label:"Sponsoren", desc:"Unsere Partner", icon:`<path d="m12 21-1.45-1.32C5.4 15.36 2 12.28 2 8.5A4.5 4.5 0 0 1 6.5 4 4.91 4.91 0 0 1 12 6a4.91 4.91 0 0 1 5.5-2A4.5 4.5 0 0 1 22 8.5c0 3.78-3.4 6.86-8.55 11.18Z"/>` },
];

const deDate = (d) => d.toLocaleDateString('de-AT', { timeZone: 'Europe/Vienna', day:'2-digit' });
const deMonth = (d) => d.toLocaleDateString('de-AT', { timeZone: 'Europe/Vienna', month:'short' }).replace('.','');


const plain = (s) => s
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/[*_`>#~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const teaser = (s, n=110) => { const t = plain(s); return t.length > n ? t.slice(0,n) + '…' : t; };
---
<Base>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker">Wien · Basketball · est. 2025</span>
        <h1 class="display" style="margin-top:14px;">Basket<span class="text-orange"> Tigers</span><br/>Vienna</h1>
        <p class="lead hero-lead">Familie, Trainings, Games und Events. <br> Getragen von einer Community, die füreinander da ist.<br> Komm vorbei und werd Teil vom Rudel.</p>
        <div class="hero-actions">
          <a class="btn" href="/kontakt/">Mitmachen →</a>
          <a class="btn2" href="/spielzeiten/">Nächste Spiele</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="num">2025</div><div class="lbl">Gegründet</div></div>
          <div class="hero-stat"><div class="num">{teams.length || 1}</div><div class="lbl">{(teams.length || 1) === 1 ? 'Team' : 'Teams'}</div></div>
          <div class="hero-stat"><div class="num">100%</div><div class="lbl">Hustle</div></div>
        </div>
      </div>
      <div class="hero-art">
        <!-- LCP-Bild: width/height = echte Bildmasse (CLS), Anzeigegroesse via CSS max-width -->
        <img
          src={heroLogo}
          alt="Basket Tigers Vienna Logo"
          class="hero-logo"
          width={heroLogoSize?.width}
          height={heroLogoSize?.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ===== MARQUEE ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" id="marquee-track">
      <span class="fill">Defense</span><span>Hustle</span><span class="fill">Team</span><span>Hunger</span><span class="fill">Wien</span><span>Basketball</span><span class="fill">Tigers</span><span>Community</span>
    </div>
  </div>
  <script>
    (function () {
      const track = document.getElementById('marquee-track');
      if (!track) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const setW = track.scrollWidth;

      const origHTML = track.innerHTML;
      while (track.scrollWidth < window.innerWidth * 3 + setW) {
        track.innerHTML += origHTML;
      }

      track.style.animation = 'none';
      track.style.willChange = 'transform';

      const DURATION = 26000;
      let pos = 0;
      let lastTs: number | null = null;

      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) lastTs = null;
      });

      function tick(ts: number) {
        if (lastTs !== null) {
          pos -= (setW / DURATION) * (ts - lastTs);
          if (pos <= -setW) pos += setW;
          track.style.transform = 'translateX(' + pos.toFixed(3) + 'px)';
        }
        lastTs = ts;
        requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    })();
  </script>

  <!-- ===== TABS ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker eyebrow">Entdecken</span>
          <h2 class="h2" style="margin-top:10px;">Alles auf einen Blick</h2>
        </div>
      </div>
      <div class="tile-grid">
        {tabs.map(t => (
          <a class="card card-hover tile" href={t.href}>
            <span class="tile-icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" set:html={t.icon} /></span>
            <span class="tile-label">{t.label}</span>
            <span class="tile-desc">{t.desc}</span>
            <span class="tile-arrow">Ansehen →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== NEXT GAME + NEWS ===== -->
  <section class="section-tight">
    <div class="container grid2" style="align-items:start;">
      <!-- Next games (Karussell: nur Spiele der naechsten 7 Tage) -->
      <div class="games-home" data-games-home>
        <div class="section-head">
          <span class="kicker eyebrow">Tip-Off</span>
          <div class="gc-nav" data-gc-nav hidden>
            <button type="button" class="gc-btn" data-gc-prev aria-label="Vorheriges Spiel">‹</button>
            <span class="gc-count" data-gc-count aria-live="polite">1 / 1</span>
            <button type="button" class="gc-btn" data-gc-next aria-label="Nächstes Spiel">›</button>
          </div>
        </div>
        <div class="card vs-card">
          <div class="gc-track" data-gc-track tabindex="0" aria-label="Kommende Spiele">
            {homeGames.map((g, i) => {
              const d = g.data.date;
              return (
                <article class="gc-slide" data-start={d ? String(d.getTime()) : ''} aria-roledescription="Spiel">
                  <div class="vs-top">
                    <span class="badge gold" data-gc-badge>{i === 0 ? 'Nächstes Spiel' : 'Diese Woche'}</span>
                    <span class="kicker" style="letter-spacing:1.5px;">
                      {d ? fmtDay(d) + (g.data.hasTime ? ' · ' + fmtTime(d) : '') : g.data.dateText}
                    </span>
                  </div>
                  <div class="vs-body">
                    <div class="vs-team"><div class="name text-orange">{g.data.team}</div><div class="sub">{g.data.isHome ? 'Heim' : 'Auswärts'}</div></div>
                    <div class="vs-mid">VS</div>
                    <div class="vs-team"><div class="name">{g.data.opponent}</div><div class="sub">{g.data.isHome ? 'Gast' : 'Gastgeber'}</div></div>
                  </div>
                  <div class="vs-foot">
                    <span class="p">
                      {g.data.location && <>📍 {g.data.location} · </>}<span style="white-space:nowrap;">{d && g.data.hasTime ? fmtTime(d) + ' Uhr' : 'Uhrzeit: TBD'}</span>
                    </span>
                    <a class="btn2 btn-sm" href="/spielzeiten/">Alle Spiele</a>
                  </div>
                </article>
              );
            })}
          </div>
          <div class="pad" data-gc-empty hidden={homeGames.length > 0}>
            <p class="p">Aktuell keine Spiele eingetragen. <a class="text-orange" href="/spielzeiten/">Zu den Spielzeiten →</a></p>
          </div>
        </div>
      </div>
      <script>
        (function () {
          const root = document.querySelector('[data-games-home]');
          if (!root) return;
          const track = root.querySelector('[data-gc-track]') as HTMLElement;
          const nav = root.querySelector('[data-gc-nav]') as HTMLElement;
          const count = root.querySelector('[data-gc-count]') as HTMLElement;
          const empty = root.querySelector('[data-gc-empty]') as HTMLElement;
          const all = Array.from(track.querySelectorAll<HTMLElement>('.gc-slide'));

          // --- Filter: nur Spiele in den naechsten 7 Tagen ---
          const now = Date.now();
          const RUNNING = 3 * 60 * 60 * 1000;
          const WEEK = 7 * 24 * 60 * 60 * 1000;
          const start = (el: HTMLElement) => el.dataset.start ? Number(el.dataset.start) : NaN;
          const upcoming = all.filter(el => !isNaN(start(el)) && start(el) >= now - RUNNING);
          let show = upcoming.filter(el => start(el) <= now + WEEK);
          // Nichts in dieser Woche -> trotzdem das naechste Spiel zeigen (bzw. TBD-Termin)
          if (!show.length) show = upcoming.slice(0, 1);
          if (!show.length) show = all.filter(el => !el.dataset.start).slice(0, 1);
          all.forEach(el => { if (!show.includes(el)) el.remove(); });

          if (!show.length) { empty.hidden = false; return; }
          show.forEach((el, i) => {
            const b = el.querySelector('[data-gc-badge]');
            if (b) b.textContent = i === 0 ? 'Nächstes Spiel' : 'Diese Woche';
            el.setAttribute('aria-label', 'Spiel ' + (i + 1) + ' von ' + show.length);
          });
          if (show.length < 2) return;

          // --- Karussell ---
          nav.hidden = false;
          let idx = 0;
          const update = () => { count.textContent = (idx + 1) + ' / ' + show.length; };
          const go = (i: number, smooth = true) => {
            idx = (i + show.length) % show.length;
            track.scrollTo({ left: show[idx].offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
            update();
          };
          update();

          // Wischen / Scrollen mit dem Finger -> Zaehler mitziehen
          let raf = 0;
          track.addEventListener('scroll', () => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              const i = Math.round(track.scrollLeft / track.clientWidth);
              if (i !== idx && i >= 0 && i < show.length) { idx = i; update(); }
            });
          }, { passive: true });

          // Automatisch weiterblaettern (pausiert bei Hover/Fokus, stoppt nach Klick)
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let paused = false, stopped = reduce;
          const timer = window.setInterval(() => {
            if (!stopped && !paused && !document.hidden) go(idx + 1);
          }, 6000);
          const stop = () => { stopped = true; window.clearInterval(timer); };
          root.addEventListener('mouseenter', () => { paused = true; });
          root.addEventListener('mouseleave', () => { paused = false; });
          root.addEventListener('focusin', () => { paused = true; });
          root.addEventListener('focusout', () => { paused = false; });
          track.addEventListener('touchstart', stop, { passive: true });

          root.querySelector('[data-gc-prev]')!.addEventListener('click', () => { stop(); go(idx - 1); });
          root.querySelector('[data-gc-next]')!.addEventListener('click', () => { stop(); go(idx + 1); });
          track.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') { stop(); go(idx + 1); e.preventDefault(); }
            if (e.key === 'ArrowLeft') { stop(); go(idx - 1); e.preventDefault(); }
          });
          window.addEventListener('resize', () => go(idx, false));
        })();
      </script>

      <!-- News -->
      <div>
        <div class="section-head">
          <span class="kicker eyebrow">Aktuelles</span>
          <a class="section-link" href="/news/">Alle News →</a>
        </div>
        <div class="card pad">
          {latestNews.length ? (
            <div class="news-list">
              {latestNews.map(n => (
                <article class="news-item">
                  <div class="news-date"><div class="d">{deDate(n.data.date)}</div><div class="m">{deMonth(n.data.date)}</div></div>
                  <div>
                    <h3 class="h3">{n.data.title}</h3>
                    <p class="p" style="margin-top:6px;">{teaser(n.body)}</p>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="p">Noch keine News. <a class="text-orange" href="/news/">Zur News-Seite →</a></p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SPONSORS ===== -->
  {sponsoren.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <div class="section-head">
          <span class="kicker eyebrow">Partner</span>
          <a class="section-link" href="/sponsoren/">Alle Sponsoren →</a>
        </div>
        <div class="grid3">
          {sponsoren.slice(0,3).map(s => {
            const logoSize = sponsorLogoSize(s.data.logo);
            return (
            <a class="card card-hover sponsor-card" href={s.data.url ?? "/sponsoren/"} target={s.data.url ? "_blank" : undefined} rel={s.data.url ? "noopener noreferrer" : undefined}>
              <img
                class="sponsor-logo"
                src={sponsorLogoUrl(s.data.logo)}
                alt={s.data.name}
                width={logoSize?.width}
                height={logoSize?.height}
                loading="lazy"
                decoding="async"
              />
              <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                <span style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px;">{s.data.name}</span>
              </div>
            </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ===== SOCIAL CTA ===== -->
  <section class="section">
    <div class="container">
      <div class="card cta-band">
        <div>
          <h2 class="h2">Bleib am Ball</h2>
          <p class="p" style="margin-top:8px; max-width:46ch;">News, Highlights und Behind-the-Scenes. <br>Folg uns auf Social Media und verpass nichts.</p>
        </div>
        <div style="display:flex; flex-direction:column; gap:14px; align-items:flex-start;">
          <Socials />
          <a class="btn" href="/kontakt/">Jetzt mitmachen →</a>
        </div>
      </div>
    </div>
  </section>

</Base>
