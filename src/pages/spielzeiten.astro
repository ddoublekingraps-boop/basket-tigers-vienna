---
import Base from "../layouts/Base.astro";
import MapsLinks from "../components/MapsLinks.astro";
import { getCollection } from "astro:content";

import { fmtDate, fmtTime, mapsUrl, mapsQuery } from "../lib/games";

const now = Date.now();
const allGames = await getCollection("games");

// Sortierung nach Datum; Spiele ohne Datum (TBD) ans Ende
const timeOf = (g: (typeof allGames)[number]) => g.data.date ? g.data.date.getTime() : Infinity;
const games = allGames.sort((a,b) => timeOf(a) - timeOf(b));
---
<Base>
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Spielbetrieb</span>
        <h1 class="h1" style="margin-top:10px;">Spiele</h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {games.length === 0 ? (
        <div class="card pad"><p class="p">Noch keine Spiele eingetragen.</p></div>
      ) : (
        <div class="card pad">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Datum</th><th>Team</th><th>Gegner</th><th>Ort</th><th>Heim/Ausw.</th><th></th></tr>
              </thead>
              <tbody>
                {games.map(g => {
                  const d = g.data.date;
                  const formattedDate = d
                    ? fmtDate(d) + ' · ' + (g.data.hasTime ? fmtTime(d) + ' Uhr' : 'Uhrzeit TBD')
                    : g.data.dateText;
                  const isUpcoming = d ? d.getTime() >= now - 1000*60*60*3 : true;

                  return (
                    <tr>
                      <td style="white-space:nowrap; font-weight:600;">{formattedDate}</td>
                      <td class="text-orange" style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px; white-space:nowrap;">{g.data.team}</td>
                      <td style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px;">{g.data.opponent}</td>
                      <td class="p">{g.data.location && <a class="map-link" href={mapsUrl(g.data.location)} data-maps-q={mapsQuery(g.data.location)} target="_blank" rel="noopener noreferrer" aria-label={'Route zu ' + g.data.location + ' in Karten öffnen'}>📍 {g.data.location}</a>}</td>
                      <td style="white-space:nowrap;">{g.data.isHome ? 'Heim' : 'Auswärts'}</td>
                      <td>{isUpcoming ? <span class="badge gold">Upcoming</span> : <span class="badge">Vorbei</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </section>
  <MapsLinks />
</Base>
