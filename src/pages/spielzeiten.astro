---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const now = Date.now();
const games = (await getCollection("games")).sort((a,b)=> a.data.date.getTime()-b.data.date.getTime());
---
<Base title="Spiele – Basket Tigers Vienna">
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Spielbetrieb</span>
        <h1 class="h1" style="margin-top:10px;">Spiele</h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {games.length === 0 ? (
        <div class="card pad"><p class="p">Noch keine Spiele eingetragen.</p></div>
      ) : (
        <div class="card pad">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Datum</th><th>Gegner</th><th>Ort</th><th></th></tr>
              </thead>
              <tbody>
                {games.map(g => (
                  <tr>
                    <td style="white-space:nowrap;">{g.data.date.toLocaleString('de-AT',{ dateStyle:'medium', timeStyle:'short' })}</td>
                    <td style="font-family:var(--font-head); text-transform:uppercase; letter-spacing:.5px;">{g.data.opponent}</td>
                    <td class="p">{g.data.location}</td>
                    <td>{g.data.date.getTime() >= now ? <span class="badge gold">Upcoming</span> : <span class="badge">Vorbei</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
