---
import Base from "../layouts/Base.astro";
import Socials from "../components/Socials.astro";
import { getEntry } from "astro:content";

const contact = await getEntry("site", "contact");
const email = contact?.data.email ?? "office@viennabasket-tigers.at";
---
<Base title="Kontakt – Basket Tigers Vienna">
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Sag Hallo</span>
        <h1 class="h1" style="margin-top:10px;">{contact?.data.title ?? "Kontakt"}</h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container grid2" style="align-items:start;">
      <div class="card pad">
        <h2 class="h3" style="font-size:20px;">Schreib uns</h2>
        <p class="p" style="margin-top:8px;">Erreich uns per E-Mail oder über unsere Kanäle.</p>
        <a class="card pad" href={`mailto:${email}`} style="display:block; margin-top:16px;">
          <span class="kicker" style="letter-spacing:2px;">E-Mail</span>
          <span style="display:block; font-family:var(--font-head); font-size:18px; margin-top:4px;">{email}</span>
        </a>
        <div style="margin-top:20px;">
          <Socials label="Social Media" />
        </div>
      </div>

      <div class="card pad">
        <h2 class="h3" style="font-size:20px;">Info</h2>
        <div class="p" style="margin-top:8px; white-space:pre-wrap;">{contact?.body ?? "Hier kann noch Text stehen (Tryouts, Zeiten, Location, etc.)."}</div>
        <div style="margin-top:18px;">
          <a class="btn" href="/spielzeiten">Nächste Spiele →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
