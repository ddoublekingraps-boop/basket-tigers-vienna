---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const allTeams = await getCollection("teams");

// Order teams naturally: Tigers 1, Tigers 2, Tigers 3, U19
const order = ["Basket Tigers 1", "Basket Tigers 2", "Basket Tigers 3", "Basket Tigers U19"];
const teams = [...allTeams].sort((a, b) => {
  const ia = order.indexOf(a.data.title);
  const ib = order.indexOf(b.data.title);
  if (ia !== -1 && ib !== -1) return ia - ib;
  return a.data.title.localeCompare(b.data.title);
});
---
<Base>
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Das Rudel</span>
        <h1 class="h1" style="margin-top:10px;">Teams</h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {teams.length === 0 ? (
        <div class="card pad"><p class="p">Bald mehr über unsere Teams.</p></div>
      ) : (
        <div class="grid2">
          {teams.map(t => (
            <a
              href={`/spieler/?team=${encodeURIComponent(t.data.title)}`}
              class="card card-hover pad team-card-link"
              style="text-decoration:none; color:inherit; display:flex; flex-direction:column; justify-content:space-between; cursor:pointer;"
            >
              <div>
                <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:center;">
                  <h2 class="h3" style="font-size:22px; color:var(--text);">{t.data.title}</h2>
                  {t.data.league ? <span class="badge">{t.data.league}</span> : null}
                </div>
                <div class="p" style="margin-top:12px; white-space:pre-wrap; color:var(--muted);">{t.body ? t.body : "Mehr Infos folgen bald."}</div>
              </div>
              <div style="margin-top:20px; display:flex; align-items:center; gap:6px; color:var(--orange); font-family:var(--font-head); font-size:14px; letter-spacing:1px; text-transform:uppercase; font-weight:600;">
                <span>Kader anzeigen</span>
                <span>→</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
