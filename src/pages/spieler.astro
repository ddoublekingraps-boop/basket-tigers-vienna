---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const spieler = (await getCollection("spieler")).sort((a,b)=> (a.data.number ?? 0) - (b.data.number ?? 0));
---
<Base title="Spieler – Basket Tigers Vienna">
  <section class="page-header">
    <div class="container">
      <div>
        <span class="kicker eyebrow">Kader</span>
        <h1 class="h1" style="margin-top:10px;">Spieler</h1>
      </div>
      <a class="btn2 btn-sm" href="/teams">Zu den Teams →</a>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {spieler.length === 0 ? (
        <div class="card pad"><p class="p">Der Kader wird bald vorgestellt – schau bald wieder vorbei.</p></div>
      ) : (
        <div class="grid3">
          {spieler.map(p => (
            <article class="card card-hover player-card">
              <div class="player-top">
                <div class="player-num">{p.data.number}</div>
                <div>
                  <div class="player-name">{p.data.name}</div>
                  <div class="kicker" style="letter-spacing:2px;">{p.data.position}</div>
                </div>
              </div>
              {p.data.photo ? <img src={p.data.photo} alt={p.data.name} style="width:100%; border-top:1px solid var(--line);" /> : null}
              {p.body ? <p class="p" style="padding:0 18px 18px;">{p.body.slice(0,140)}{p.body.length>140?"…":""}</p> : null}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
