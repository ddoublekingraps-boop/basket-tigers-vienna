---
import Socials from "./Socials.astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Basket Tigers Vienna – Startseite">
          <img src="/assets/logo.png" alt="" width="42" height="42" class="brand-logo" />
          <span class="brand-name">Basket Tigers<small>Vienna</small></span>
        </a>
        <p class="p">Basketball Community aus Wien.<br> Komm vorbei und werd Teil des Rudels.</p>
        <Socials label="Folge uns" />
      </div>

      <div class="footer-col">
        <h4>Verein</h4>
        <a href="/teams">Teams</a>
        <a href="/spieler">Spieler</a>
        <a href="/verein">Über uns</a>
        <a href="/sponsoren">Sponsoren</a>
      </div>

      <div class="footer-col">
        <h4>Spielbetrieb</h4>
        <a href="/spielzeiten">Spiele</a>
        <a href="/trainingszeiten">Training</a>
        <a href="/news">News</a>
        <a href="/kontakt">Kontakt</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Basket Tigers Vienna</span>
      <nav class="footer-legal" aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
      <span>Made by Aldin Kehic 🐅🏀</span>
    </div>
  </div>
</footer>
