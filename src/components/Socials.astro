---
import { getEntry } from "astro:content";

// Renders only the social platforms that have a value set in the admin (Kontakt).
// `label` optionally shows a small heading above the icons.
const { label = "" } = Astro.props;

const contact = await getEntry("site", "contact");
const data: Record<string, string | undefined> = contact?.data ?? {};

// Normalize a raw value into a full URL. Handles "@handle" and bare handles too.
const normalize = (raw: string | undefined, base: string) => {
  if (!raw) return "";
  const v = raw.trim();
  if (!v) return "";
  if (/^https?:\/\//i.test(v)) return v;
  return base + v.replace(/^@/, "");
};

const socials = [
  {
    name: "Instagram",
    href: normalize(data.instagram, "https://instagram.com/"),
    icon: `<path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.74.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.04-.9-.19-1.38-.32-1.7a2.85 2.85 0 0 0-.68-1.06 2.85 2.85 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.5 4.01 15.15 4 12 4Zm0 3.06A4.94 4.94 0 1 1 12 16.94 4.94 4.94 0 0 1 12 7.06Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.15-2.96a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"/>`,
  },
  {
    name: "TikTok",
    href: normalize(data.tiktok, "https://tiktok.com/@"),
    icon: `<path d="M16.5 3c.3 2.1 1.5 3.6 3.5 3.9V10c-1.4.1-2.6-.3-3.8-1v5.6c0 3.3-2.3 5.6-5.4 5.6A5.3 5.3 0 0 1 5.4 15c0-3 2.3-5.3 5.3-5.3.4 0 .7 0 1.1.1v3.1a2.3 2.3 0 0 0-1.1-.3 2.3 2.3 0 0 0-2.3 2.4c0 1.4 1 2.4 2.4 2.4 1.4 0 2.4-1 2.4-2.6V3h2.8Z"/>`,
  },
  {
    name: "YouTube",
    href: normalize(data.youtube, "https://youtube.com/@"),
    icon: `<path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.7C19.4 5.2 12 5.2 12 5.2s-7.4 0-8.9.4A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.9.9 1.5 1.7 1.7 1.5.4 8.9.4 8.9.4s7.4 0 8.9-.4a2.5 2.5 0 0 0 1.7-1.7C23 15.2 23 12 23 12Zm-13.2 3V9l5.2 3-5.2 3Z"/>`,
  },
  {
    name: "Facebook",
    href: normalize(data.facebook, "https://facebook.com/"),
    icon: `<path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>`,
  },
].filter((s) => s.href);
---
{socials.length > 0 && (
  <div class="socials">
    {label && <span class="socials-label">{label}</span>}
    <div class="socials-row">
      {socials.map((s) => (
        <a
          class="social-link"
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          title={s.name}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" set:html={s.icon} />
        </a>
      ))}
    </div>
  </div>
)}
