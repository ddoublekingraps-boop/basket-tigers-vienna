---
const links = [
  { href: '/', label: 'Home' },
  { href: '/teams/', label: 'Teams' },
  { href: '/spielzeiten/', label: 'Spiele' },
  { href: '/trainingszeiten/', label: 'Training' },
  { href: '/news/', label: 'News' },
  { href: '/verein/', label: 'Verein' },
  { href: '/kontakt/', label: 'Kontakt' },
];

const path = Astro.url.pathname;
// Pfade auf eine Form mit Trailing Slash normalisieren, damit die aktive
// Seite sowohl unter /teams als auch unter /teams/ erkannt wird.
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const isActive = (href: string) => {
  const target = withSlash(href);
  const current = withSlash(path);
  return target === '/' ? current === '/' : current === target || current.startsWith(target);
};
---
<header class="site-header">
  <div class="container nav-bar">
    <a href="/" class="brand" aria-label="Basket Tigers Vienna – Startseite">
      <img src="/assets/logo.png" alt="" width="42" height="42" class="brand-logo" />
      <span class="brand-name">Basket Tigers<small>Vienna</small></span>
    </a>

    <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav id="primary-nav" class="nav-menu" aria-label="Hauptnavigation">
      {links.map(l => (
        <a href={l.href} class={"nav-link" + (isActive(l.href) ? " is-active" : "")} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
      <a class="btn btn-sm nav-cta" href="/kontakt/">Mitmachen</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const header = document.querySelector('.site-header');
  if (toggle && header) {
    const close = () => { header.classList.remove('nav-open'); toggle.setAttribute('aria-expanded', 'false'); };
    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('nav-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    header.querySelectorAll('.nav-menu a').forEach((a) => a.addEventListener('click', close));
    window.addEventListener('resize', () => { if (window.innerWidth > 900) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>
